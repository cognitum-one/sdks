{
  "name": "@cognitum-one/sdk",
  "version": "0.2.1",
  "description": "Official Cognitum SDK for Node.js and TypeScript",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./seed": {
      "types": "./dist/seed/index.d.ts",
      "import": "./dist/seed/index.js",
      "require": "./dist/seed/index.cjs"
    },
    "./seed/discovery/mdns": {
      "types": "./dist/seed/discovery/mdns.d.ts",
      "import": "./dist/seed/discovery/mdns.js",
      "require": "./dist/seed/discovery/mdns.cjs"
    },
    "./agentic": {
      "types": "./dist/agentic/index.d.ts",
      "import": "./dist/agentic/index.js",
      "require": "./dist/agentic/index.cjs"
    }
  },
  "bin": {
    "cognitum": "./dist/cli.mjs",
    "cognitum-sdk": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests"
  },
  "keywords": [
    "cognitum",
    "ai",
    "mcp",
    "sdk",
    "seed"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "undici": "^6.0.0"
  },
  "peerDependencies": {
    "multicast-dns": "^7.2.5"
  },
  "peerDependenciesMeta": {
    "multicast-dns": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^25.6.0",
    "eslint": "9.39.5",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "8.64.0",
    "vitest": "^3.2.6"
  }
}
