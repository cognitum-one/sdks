{
  "name": "@cognitum-one/sdk",
  "version": "0.3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cognitum-one/sdks.git",
    "directory": "sdks/node"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "description": "Official Cognitum SDK for Node.js and TypeScript",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./seed": {
      "types": "./dist/seed/index.d.ts",
      "import": "./dist/seed/index.js",
      "require": "./dist/seed/index.cjs"
    },
    "./seed/discovery/mdns": {
      "types": "./dist/seed/discovery/mdns.d.ts",
      "import": "./dist/seed/discovery/mdns.js",
      "require": "./dist/seed/discovery/mdns.cjs"
    },
    "./agentic": {
      "types": "./dist/agentic/index.d.ts",
      "import": "./dist/agentic/index.js",
      "require": "./dist/agentic/index.cjs"
    },
    "./meta-llm": {
      "types": "./dist/meta-llm/index.d.ts",
      "import": "./dist/meta-llm/index.js",
      "require": "./dist/meta-llm/index.cjs"
    },
    "./meta-proxy": {
      "types": "./dist/meta-proxy/index.d.ts",
      "import": "./dist/meta-proxy/index.js",
      "require": "./dist/meta-proxy/index.cjs"
    },
    "./metaharness": {
      "types": "./dist/metaharness/index.d.ts",
      "import": "./dist/metaharness/index.js",
      "require": "./dist/metaharness/index.cjs"
    },
    "./harnessaas": {
      "types": "./dist/harnessaas/index.d.ts",
      "import": "./dist/harnessaas/index.js",
      "require": "./dist/harnessaas/index.cjs"
    },
    "./sse": {
      "types": "./dist/sse/index.d.ts",
      "import": "./dist/sse/index.js",
      "require": "./dist/sse/index.cjs"
    }
  },
  "bin": {
    "cognitum": "./dist/cli.mjs",
    "cognitum-sdk": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests"
  },
  "keywords": [
    "cognitum",
    "ai",
    "mcp",
    "sdk",
    "seed"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "undici": "^6.0.0"
  },
  "peerDependencies": {
    "multicast-dns": "^7.2.5"
  },
  "peerDependenciesMeta": {
    "multicast-dns": {
      "optional": true
    }
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "10.8.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "8.65.0",
    "vitest": "^3.2.6"
  }
}
