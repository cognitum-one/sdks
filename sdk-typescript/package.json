{
  "name": "@ruv/cognitum-sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for Cognitum chip simulator",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cognitum",
    "simulator",
    "parallel-computing",
    "sdk",
    "typescript"
  ],
  "author": "ruv.io",
  "license": "MIT",
  "dependencies": {
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitest/coverage-v8": "^1.0.4",
    "eslint": "^8.56.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4"
  },
  "peerDependencies": {
    "@ruv/cognitum": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@ruv/cognitum": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
